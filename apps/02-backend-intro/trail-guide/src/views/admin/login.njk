{% extends "layouts/_base.njk" %}

{% block main_content %}
  <article style="max-width: 420px; margin: 3rem auto;">
    <h1>Admin Login</h1>

    <form method="POST" action="/login">
      <label for="password">Admin Password</label>
      <input
        type="password"
        id="password"
        name="password"
        placeholder="Enter password"
        {{ 'aria-invalid="true"' | safe if error }}
        required
        autofocus
      />
      {% if error %}
        <small>{{ error }}</small>
      {% endif %}

      <button type="submit">Log In</button>
    </form>
  </article>
{% endblock %}
