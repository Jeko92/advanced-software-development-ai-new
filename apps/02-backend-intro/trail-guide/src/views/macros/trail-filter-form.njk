{% macro trailFilterForm(action, regions, filters) %}
  <section class="search">
    <form method="GET" action="{{ action }}">
      <div class="grid">
        <!-- Search term-->
        <div>
          <label for="q">Search trails</label>
          <input
            id="q"
            type="text"
            name="q"
            value="{{ filters.q | default('') }}"
            placeholder="Zugspitze via Reintal.."
          />
        </div>

        <!-- Search trails by region-->
        <div>
          <label for="region">Region</label>
          <select id="region" name="region">
            <option value="">All regions</option>
            {% for region in regions %}
              <option
                value="{{ region.slug }}"
                {{ 'selected' if filters.region == region.slug }}
              >
                {{ region.name | default('') }}
              </option>
            {% endfor %}
          </select>
        </div>

        <!-- Search trails by difficulty-->
        <div class="field-col">
          <label for="difficulty">Difficulty</label>
          <select id="difficulty" name="difficulty">
            <option value="">All difficulties</option>
            <option
              value="easy"
              {{ 'selected' if filters.difficulty == 'easy' }}
            >
              Easy
            </option>
            <option
              value="moderate"
              {{ 'selected' if filters.difficulty == 'moderate' }}
            >
              Moderate
            </option>
            <option
              value="hard"
              {{ 'selected' if filters.difficulty == 'hard' }}
            >
              Hard
            </option>
          </select>
        </div>

        <!-- Search trail by distance -->
        <div class="field-col">
          <label for="maxDistance">Max distance (km)</label>
          <input
            type="number"
            id="maxDistance"
            name="maxDistance"
            placeholder="e.g. 10"
            value="{{ filters.maxDistance | default('') }}"
            min="0"
            step="0.1"
          />
        </div>

        <input type="submit" value="Search" />
      </div>
    </form>
  </section>
{% endmacro %}
