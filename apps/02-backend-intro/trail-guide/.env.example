PORT=3000
DB_PATH=<put DB path here>
API_KEY=<your API Key>
LOG_DIR=<logs dir here>
LOG_FILE_NAME=<logs file name here>
WINDOW_MS=<rate-limit window in ms, e.g. 60000>
MAX_REQUESTS_PER_WINDOW=<max write requests per window, e.g. 10>
ADMIN_USER=<admin username here>
ADMIN_PASS=<your password here>

# Secret used to sign the admin session cookie so it can't be forged by
# just setting `admin=true` from the browser. Required, no insecure default.
COOKIE_SECRET=<random secret here>
