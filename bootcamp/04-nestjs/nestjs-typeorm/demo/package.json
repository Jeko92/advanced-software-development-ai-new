{
  "name": "@bootcamp/nestjs-typeorm-demo",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "bun --env-file=.env dist/main.js",
    "dev": "nest --env-file=.env start --exec bun --watch",
    "start:debug": "nest start --env-file=.env --debug --watch",
    "start:prod": "node --env-file=.env dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "typeorm": "node --env-file=.env --import tsx ./node_modules/typeorm/cli.js -d src/db/data-source.ts",
    "migration:generate": "pnpm typeorm -- migration:generate",
    "migration:run": "pnpm typeorm -- migration:run",
    "migration:revert": "pnpm typeorm -- migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/typeorm": "^11.0.3",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@bootcamp/eslint-config": "workspace:*",
    "@bootcamp/prettier-config": "workspace:*",
    "@bootcamp/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "globals": "^17.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
