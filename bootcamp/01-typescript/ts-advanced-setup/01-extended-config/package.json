{
  "name": "@bootcamp/extended-config-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal demo for TypeScript Advanced Setup doc 1: extended tsconfig coding rules",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@bootcamp/eslint-config": "workspace:*",
    "@bootcamp/prettier-config": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "prettier": "@bootcamp/prettier-config"
}
